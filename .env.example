VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Modo demonstração do feed: com `1`, uma falha ao buscar o feed cai em posts
# FICTÍCIOS, e a tela exibe um aviso vermelho dizendo que são fictícios.
# Serve para trabalhar interface sem backend. NUNCA ligue em produção.
# Vazio (padrão): falha de rede vira estado de erro com "Tentar de novo".
#
# Antes esse fallback era INCONDICIONAL e SILENCIOSO — qualquer erro exibia
# posts inventados como se fossem reais, sem aviso nenhum.
VITE_FEED_DEMO=

# --- Flags de lançamento (src/shared/flags.ts) ---
#
# TODAS têm padrão DESLIGADO. Deixar vazio, ausente ou com qualquer valor que
# não seja `1`/`true` mantém a feature fora do ar. Um deploy sem nenhuma destas
# variáveis já sai com o corte de lançamento correto — ligar é sempre um ato
# deliberado.
#
# ATENÇÃO: `VITE_*` é lida em TEMPO DE BUILD. Preencher no painel da hospedagem
# não liga nada sozinho: exige REBUILD + REDEPLOY.
#
# Ligas/Campeonatos. `1`: a aba "Ligas" volta à navegação e a tela de lobby
# fica alcançável. Vazio (padrão): a aba some e não há nenhum caminho até a
# tela — nem por rota, nem por botão.
# NÃO LIGUE ANTES DE PLUGAR A TELA NO BANCO: hoje o lobby exibe participantes e
# pódio escritos à mão no código (nomes e notas que não existem). A função
# `getChampionshipLobby` existe em src/db/supabase.ts e não é usada por ela.
VITE_FEATURE_LIGAS=
#
# Auê+ (assinatura). `1`: os caminhos de venda da assinatura aparecem.
# Vazio (padrão): nada de assinatura é oferecido. Não há provedor de pagamento
# integrado — nada seria cobrado de fato.
VITE_FEATURE_ASSINATURA=
#
# Notificações push. `1`: os controles de notificação aparecem. Vazio (padrão):
# não são oferecidos. Só faz sentido ligar DEPOIS de configurar VAPID
# (VITE_VAPID_PUBLIC_KEY aqui embaixo e os segredos da Edge Function); sem isso
# o usuário liga o interruptor e nenhuma notificação chega nunca.
VITE_FEATURE_PUSH=
#
# Criação avançada de comunidades/grupos. `1`: reservado para quando as telas
# de criação/entrada em grupo entrarem no roteador. Vazio (padrão): elas ficam
# fora — hoje são código de protótipo, com `alert()` como interface.
VITE_FEATURE_GRUPOS_AVANCADOS=
#
# ---------------------------------------------------------------------------
# As seis abaixo entraram junto com o LOGIN ANÔNIMO.
#
# Antes dele, "tem sessão?" era sempre falso na prática: existia só o botão do
# Google e ninguém o usava. Vários caminhos do app estavam desligados por
# acidente. Com `signInAnonymously` no boot, todos ligam de uma vez — estas
# variáveis são o que transforma esse acidente em decisão.
#
# Para o MVP, deixe TODAS vazias.
# ---------------------------------------------------------------------------
#
# Feed da comunidade. `1`: a Home mostra o feed E toda gravação passa a ser
# publicada nele automaticamente. Vazio (padrão): a Home é só o convite para
# gravar e `criarPostDeAudio` não é chamado.
# NÃO LIGUE SEM DECIDIR A PUBLICAÇÃO: com login anônimo, ligar isto faz o
# arroto de todo visitante virar post público sem que ele tenha escolhido.
VITE_FEATURE_FEED=
#
# Ranking global. `1`: a aba volta à navegação. Vazio (padrão): fora.
# NÃO LIGUE SEM RESOLVER A IDENTIDADE: a view `global_ranking` se protegia de
# anônimos com `user_id IS NOT NULL`, e esse filtro deixou de filtrar quando
# toda visita passou a ter sessão. Ligar hoje enche o ranking de "Arrotador
# a1b2c3".
VITE_FEATURE_RANKING=
#
# Tela de perfil. `1`: o avatar volta ao cabeçalho e leva ao perfil. Vazio
# (padrão): o cabeçalho é só a marca. Sem login, o perfil é de alguém que
# nunca se cadastrou.
VITE_FEATURE_PERFIL=
#
# XP e níveis no card de resultado. `1`: a linha "+N XP" e o aviso de limite
# aparecem. Vazio (padrão): não aparecem.
# O teto de 5 gravações com XP a cada 24h continua existindo no banco de
# qualquer jeito; o que esta variável controla é FALAR dele. Numa disputa
# presencial (5 pessoas x 3 rounds = 15 gravações no mesmo aparelho) o aviso
# apareceria no meio da brincadeira.
VITE_FEATURE_XP=
#
# Login social (Google). `1`: o botão "Entrar" volta ao cabeçalho. Vazio
# (padrão): não há login — a identidade é a sessão anônima.
# Ao ligar isto no MVP 2, entrar deve PROMOVER a conta anônima
# (`supabase.auth.linkIdentity`), preservando o histórico. Um `signInWithOAuth`
# puro cria uma segunda conta e o usuário perde tudo o que gravou.
VITE_FEATURE_LOGIN_SOCIAL=
#
# Disputa presencial (segunda fatia do lançamento). `1`: a tela entra no
# roteador. Vazio (padrão): fora.
# Só ligue depois de rodar uma disputa de 5 participantes x 3 rounds de ponta a
# ponta num telefone real.
VITE_FEATURE_DISPUTA_LOCAL=

# Chave VAPID PÚBLICA do Web Push. É pública por natureza (vai para o bundle),
# mas precisa ser exatamente a mesma de VAPID_PUBLIC_KEY abaixo.
# Gere o par com: npx web-push generate-vapid-keys
# Sem esta variável (ou com o placeholder), o botão de notificações aparece
# desabilitado e a feature fica explicitamente indisponível — não falha em silêncio.
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# E-mail de contato para privacidade e pedidos de exclusão.
#
# O VALOR ABAIXO É O REAL DO LANÇAMENTO, decidido por Luiz em 2026-08-08 — não é
# placeholder e não deve ser trocado por um de exemplo. É o endereço publicado na
# política de privacidade (`/privacidade`), nos termos de uso (`/termos`) e na
# tela "Apagar minha conta".
#
# ATENÇÃO — `VITE_*` É LIDA EM TEMPO DE BUILD. Não basta existir neste arquivo:
# ela precisa estar no environment **Production** (e Preview) da hospedagem ANTES
# do build. Um deploy feito sem ela publica a política com dois avisos VERMELHOS
# na cara do usuário ("o canal de contato ainda não foi configurado"), e
# configurar a variável depois no painel NÃO conserta — exige build novo.
#
# Vazio, nada é inventado: as telas declaram o canal indisponível em vez de
# oferecer um endereço que não existe.
VITE_CONTATO_PRIVACIDADE=buildealabs@gmail.com

# --- Google AdSense: a colocação já existe no código e liga sozinha ---
#
# A posição do anúncio está implementada no feed (após o 3º post). Enquanto as
# DUAS variáveis abaixo estiverem vazias, nada é carregado do Google e nada
# aparece para o usuário — em produção o espaço nem é renderizado. Preencher as
# duas e publicar é o suficiente para os anúncios entrarem no ar: não há
# mudança de código pendente.
#
# ATENÇÃO — VARIÁVEL `VITE_*` É LIDA EM TEMPO DE BUILD, NÃO EM RUNTIME.
# Preencher estes valores no painel da hospedagem NÃO liga os anúncios sozinho:
# é preciso REBUILD + REDEPLOY. Verificado neste repositório — sem as variáveis,
# o Vite elimina todo o código do AdSense do bundle (zero ocorrências de
# `pagead2.googlesyndication.com`); com elas, o script e a tag <ins> aparecem.
#
# Id de cliente, do painel do AdSense. O do Auê é `ca-pub-5542349230926522` —
# está escrito aqui de propósito: é o mesmo id que `public/ads.txt` publica na
# raiz do site e que aparece no HTML servido. Não é segredo, e mantê-lo secreto
# só faria alguém perder tempo procurando na hora de ligar os anúncios.
VITE_ADSENSE_CLIENT=
# Id do bloco in-feed criado no painel (ex.: 1234567890).
# ATENÇÃO: o feed está atrás de VITE_FEATURE_FEED, que NÃO deve ser ligada só
# para ter anúncio — ligá-la publica o arroto de todo visitante no feed público.
VITE_ADSENSE_SLOT_FEED=
# Id do bloco da TELA DE RESULTADO (`src/features/audio/resultado/`).
# É a colocação que rende sem depender de flag nenhuma: toda gravação passa por
# aquela tela, e ela está no ar desde o lançamento. Preencher esta + o
# VITE_ADSENSE_CLIENT e publicar já coloca anúncio no ar.
VITE_ADSENSE_SLOT_RESULT=
#
# AINDA PENDENTE ANTES DE LIGAR (não é código):
#   1. Decidir o aviso de consentimento (LGPD/consentimento de cookies do Google).
#      Não há nenhum implementado aqui.
#
# JÁ RESOLVIDO: a política de privacidade e os termos de uso existem em páginas
# públicas (`/privacidade` e `/termos`), linkadas do app e listadas no sitemap.
# A frase da política sobre anúncios é DERIVADA destas variáveis
# (`src/features/legal/anunciosAtivos.ts`): preencher o cliente + um slot muda o
# texto publicado automaticamente, e há teste travando essa coerência.

# --- Supabase Edge Functions (server-side secrets, never expose to the client) ---
# Web Push (VAPID) keys used by the send-push function
# VAPID_PUBLIC_KEY deve ser idêntica a VITE_VAPID_PUBLIC_KEY.
VAPID_SUBJECT=mailto:seu-email@exemplo.com
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
# Shared secret required in the x-webhook-secret header to call the send-push
# function. Without it the function runs with the service role key and would be
# publicly callable.
PUSH_WEBHOOK_SECRET=YOUR_PUSH_WEBHOOK_SECRET
