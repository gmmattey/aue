{
  // Projeto TypeScript dos testes.
  //
  // Antes este arquivo não era rodado por ninguém: o `vitest` estava declarado
  // em devDependencies sem estar em `node_modules`, então incluí-lo em
  // `tsc -b` quebrava com "Cannot find module 'vitest'". O pacote está
  // instalado desde o commit e0f2655 e a exceção deixou de existir — ele agora
  // roda no `npm run typecheck`, como segundo passo.
  //
  // NÃO é `composite` e NÃO entra em `references` do tsconfig.json: seria
  // preciso tornar o tsconfig.app.json composite e habilitar emit nele, uma
  // mudança de build desproporcional. Como projeto avulso ele pode simplesmente
  // incluir o `src` inteiro e checar teste junto com o código que o teste
  // importa, sem conflito de "arquivo em dois projetos".
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": []
}
