{
  "hosting": {
    "site": "aue",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/x/:codigo",
        "destination": "https://enjykrpprjfmeqxunzcs.supabase.co/functions/v1/og-preview?codigo=:codigo",
        "type": 302
      }
    ],
    "rewrites": [
      { "source": "/privacidade", "destination": "/privacidade.html" },
      { "source": "/termos", "destination": "/termos.html" },
      { "source": "/como-jogar", "destination": "/como-jogar.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/push-sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
